{
  "feature": "webui-and-pm-workspace",
  "storyboards": [
    {
      "id": "storyboard:rtm_dashboard_drilldown",
      "description": "User navigates to RTM Dashboard and drills down into coverage.",
      "steps": [
        { "screen": "global-shell", "action": "Navigate to Dashboard", "next_screen": "rtm-dashboard", "expected_state": "dash_loading" },
        { "screen": "rtm-dashboard", "action": "LOAD_SUCCESS", "expected_state": "dash_default" },
        { "screen": "rtm-dashboard", "action": "Drill-down", "expected_state": "view_drilldown" }
      ]
    },
    {
      "id": "storyboard:approval_gate_decision",
      "description": "User makes a decision on an approval gate.",
      "steps": [
        { "screen": "global-shell", "action": "Navigate to Approval", "next_screen": "approval-gate", "expected_state": "app_loading" },
        { "screen": "approval-gate", "action": "EVALUATED", "expected_state": "app_default" },
        { "screen": "approval-gate", "action": "Approve", "expected_state": "app_decision_submitted" }
      ]
    }
  ]
}